# Copia este archivo a .env.local y llena los valores. Nunca subas .env.local al repo.

# Claude (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=
# Opcional. Por defecto: claude-opus-5-5
ANTHROPIC_MODEL=
# Opcional. Por defecto: low
AGENDA_EFFORT=

# Supabase (Project Settings > API). Sin ellas, en desarrollo se usa el repositorio en memoria.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Protege la ruta de limpieza diaria (/api/limpieza)
CRON_SECRET=

# Límites de uso de la demo (opcionales; enteros positivos)
# Conversaciones nuevas por día, entre todos los visitantes. Por defecto: 300
AGENDA_TOPE_DIARIO=
# Mensajes por sesión y por hora. Por defecto: 20
AGENDA_LIMITE_SESION_HORA=
# Mensajes por IP y por hora. Por defecto: 40
AGENDA_LIMITE_IP_HORA=
# Mensajes del visitante por conversación. Por defecto: 30
AGENDA_MAX_MENSAJES_CONVERSACION=
