# Copia este archivo a .env.local y llena los valores. Nunca subas .env.local al repo.

# La IA. Con ANTHROPIC_API_KEY contesta Claude (de pago); si no está, con GEMINI_API_KEY contesta Gemini (plan gratis).
# Si están las dos, gana Claude. Sin ninguna, en desarrollo contesta el responder guionado sin IA.

# Gemini (https://aistudio.google.com/apikey). En el plan gratis Google puede usar los mensajes para mejorar sus productos.
GEMINI_API_KEY=
# Opcional. Por defecto: gemini-3.5-flash-lite. Usa un modelo 3.x: los 2.x ya no se dan a cuentas nuevas.
GEMINI_MODEL=

# Claude (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=
# Opcional. Por defecto: claude-opus-5-5
ANTHROPIC_MODEL=
# Opcional. Por defecto: low
AGENDA_EFFORT=

# Supabase (Project Settings > API). Sin ellas, en desarrollo se usa el repositorio en memoria.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Protege la ruta de limpieza diaria (/api/limpieza)
CRON_SECRET=

# Sal secreta para guardar la IP como hash en los contadores (un texto largo y aleatorio).
# Obligatoria en producción; en desarrollo, si falta, se usa una sal fija solo para desarrollo.
AGENDA_SAL_IP=

# Límites de uso de la demo (opcionales; enteros positivos)
# Conversaciones nuevas por día, entre todos los visitantes. Por defecto: 100
AGENDA_TOPE_DIARIO=
# Mensajes por día que llegan al modelo, entre todos los visitantes (tope del gasto diario de la API). Por defecto: 300
# Con Gemini gratis, ponlo en tu tope diario de consultas entre 6: cada mensaje hace de 1 a 6 consultas.
AGENDA_TOPE_MENSAJES_DIA=
# Mensajes por sesión y por hora. Por defecto: 20
AGENDA_LIMITE_SESION_HORA=
# Mensajes por IP y por hora. Por defecto: 40
AGENDA_LIMITE_IP_HORA=
# Mensajes por conversación, del visitante y de la persona del negocio juntos. Por defecto: 30
AGENDA_MAX_MENSAJES_CONVERSACION=
# Sesiones nuevas por IP y por hora (cada una siembra citas ficticias en la base). Por defecto: 10
AGENDA_LIMITE_SESIONES_IP_HORA=
